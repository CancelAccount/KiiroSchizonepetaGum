# ── Visual Studio / Rider / VSCode IDE 临时文件 ──
.vs/
.idea/
.vscode/
*.user
*.suo
*.userprefs
*.swp
*~

# ── .NET / C# 编译中间产物 ──
[Bb]in/
[Oo]bj/
*.dll.config
*.pdb
*.ilk
*.meta
*.exp
*.map

# ── NuGet ──
*.nupkg
*.snupkg
.nuget/
packages/

# ── RimWorld mod 编译输出 ──
# Assemblies/ 下的 DLL 是 1.6 的发行产物：1.7 起游戏删除 RimWorldWin64_Data\Managed，
# 1.6 工程已无法重建，故 dll 必须入库以保证 clone 即玩
1.6/Assemblies/*.pdb
1.6/Assemblies/*.xml

# ── Unity 工程（UnityProject/）──
# Unity 自动生成目录与 AB 构建产物，可由 UnityProject/Assets 重新生成
UnityProject/Library/
UnityProject/Temp/
UnityProject/Logs/
UnityProject/obj/
UnityProject/Build/
UnityProject/UserSettings/
UnityProject/*.csproj
UnityProject/*.sln
1.6/AssetBundles/

# ── 操作系统产生的杂项文件 ──
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# macOS
.DS_Store
.AppleDouble
.LSOverride
# Linux
*~
.directory

# ── 备份与临时文件 ──
*.bak
*.tmp
*.log
*.orig

# ── RimWorld 运行时生成的缓存（不应出现在 mod 仓库里）──
*.cache
Cache/

# ── 发包流水线产物 ──
# dist/stage 为组装目录，dist/*.zip 为发布包，均可由 Tools/Build-Release.ps1 重建
dist/
# 调试版编译输出（与入库的发行版 dll 隔离）
1.6/AssembliesDebug/
1.7/AssembliesDebug/
