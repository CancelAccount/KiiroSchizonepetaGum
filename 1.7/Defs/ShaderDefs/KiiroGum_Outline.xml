<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 1.7 着色器体系：GLSL 源码置于 1.7/Shaders/，由 ShaderDefRegistry 在加载时
       扫描各加载目录下的 Shaders 文件夹并注册；不再依赖 Unity AssetBundle。
       shaderPath（ShaderTypeDef）取最后一段 defName 后命中本 def 即直接使用源码版本。 -->
  <ShaderDef>
    <defName>KiiroGumOutline</defName>
    <shaderProgram>
      <fragmentShaderFileName>KiiroGumOutline.frag.glsl</fragmentShaderFileName>
      <!-- 半透明混合（SrcAlpha / OneMinusSrcAlpha），描边带抗锯齿边缘 -->
      <transparent>true</transparent>
      <!-- 参与深度测试（被更高的建筑遮挡），但不写深度（不影响后续物体） -->
      <depthTest>true</depthTest>
      <depthWrite>false</depthWrite>
      <!-- 描边层是平面 mesh，双面可见，与 1.6 的 Cull Off 一致 -->
      <cullMode>None</cullMode>
      <!-- 本体与植物（Cutout / CutoutPlant）均为 2900 且写深度；
           描边必须排在其后（2901），低矮植物先写下的深度才能正确遮挡描边。
           若取 2900 之前一档，描边会先于所有 2900 实体绘制且不写深度，
           随后被植物像素无条件覆盖（1.6 的 AlphaTest-1 假设在 1.7 排序模型下失效）。 -->
      <renderQueue>2901</renderQueue>
    </shaderProgram>
  </ShaderDef>

</Defs>
