<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ================================================== -->
  <!-- RecipeDef：荆芥口香糖制作配方                        -->
  <!-- ================================================== -->

  <!-- ── ×1 单做 ── -->
  <!-- 成本：4 片荆芥叶 / 工时：100                          -->
  <RecipeDef>
    <defName>Kiiro_Make_SchizonepetaGum</defName>
    <label>make schizonepeta chewing gum</label>
    <description>Make a schizonepeta chewing gum from schizonepeta leaves.</description>
    <jobString>Making schizonepeta chewing gum.</jobString>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>100</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Kiiro_SchizonepetaLeaf</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Kiiro_SchizonepetaLeaf</li>
      </thingDefs>
    </fixedIngredientFilter>
    <recipeUsers>
      <li>DrugLab</li>
    </recipeUsers>
    <products>
      <Kiiro_SchizonepetaGum>1</Kiiro_SchizonepetaGum>
    </products>
    <workSkill>Intellectual</workSkill>
    <researchPrerequisite>Kiiro_MixedMedicineHerbal</researchPrerequisite>
  </RecipeDef>

  <!-- ── ×4 批量 ── -->
  <!-- 成本：16 片荆芥叶（4 × 4）/ 工时：400（100 × 4）     -->
  <RecipeDef>
    <defName>Kiiro_Make_BulkSchizonepetaGum</defName>
    <label>make schizonepeta chewing gum x4</label>
    <description>Make a batch of 4 schizonepeta chewing gums from schizonepeta leaves.</description>
    <jobString>Making schizonepeta chewing gum.</jobString>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>400</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Kiiro_SchizonepetaLeaf</li>
          </thingDefs>
        </filter>
        <count>16</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Kiiro_SchizonepetaLeaf</li>
      </thingDefs>
    </fixedIngredientFilter>
    <recipeUsers>
      <li>DrugLab</li>
    </recipeUsers>
    <products>
      <Kiiro_SchizonepetaGum>4</Kiiro_SchizonepetaGum>
    </products>
    <workSkill>Intellectual</workSkill>
    <researchPrerequisite>Kiiro_MixedMedicineHerbal</researchPrerequisite>
  </RecipeDef>

</Defs>
